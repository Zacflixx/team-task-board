# Copy this file to .env for local runs (npx netlify-cli dev). Never commit .env.
# On Netlify, set the same names under the project's environment variables instead.

# Required. The passcode your team types to open the board.
TEAM_PASSCODE=change-me-to-something-long

# Optional image attachments on Cloudinary (all three are needed). Leave out to switch images off.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=team-task-board

# Optional GitHub backup. Use a SEPARATE private repo, not the one Netlify deploys from.
# GITHUB_TOKEN=
# BACKUP_GITHUB_REPO=owner/team-task-board-data
# BACKUP_GITHUB_BRANCH=main
# BACKUP_GITHUB_PATH=tasks.json
